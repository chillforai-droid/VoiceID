{
  "rewrites": [
    {
      "source": "/api/media/upload",
      "destination": "/api/upload"
    },
    {
      "source": "/api/media/upload-auth",
      "destination": "/api/upload-auth"
    },
    {
      "source": "/api/media/download-auth",
      "destination": "/api/download-auth"
    },
    {
      "source": "/api/media/download",
      "destination": "/api/download"
    },
    {
      "source": "/api/media/ack",
      "destination": "/api/ack"
    },
    {
      "source": "/api/media/delete/:objectKey",
      "destination": "/api/delete/:objectKey"
    },
    {
      "source": "/api/media/story",
      "destination": "/api/story-media"
    },
    {
      "source": "/u/:username",
      "destination": "/api/profile-og"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
